<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>targetlint Report</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: -apple-system, "Segoe UI", system-ui, sans-serif;
    font-size: 14px;
    line-height: 1.6;
    color: #1f2328;
    background: #ffffff;
    padding: 32px 16px;
  }
  .container { max-width: 760px; margin: 0 auto; }
  h1 { font-size: 22px; font-weight: 700; margin-bottom: 4px; }
  .meta { color: #57606a; font-size: 13px; margin-bottom: 16px; }
  .meta span { display: inline-block; margin-right: 20px; }
  .badges { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 28px; }
  .badge {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: 4px; font-size: 13px;
    font-weight: 600; color: #fff;
  }
  .badge-critical { background: #dc2626; }
  .badge-high     { background: #ea580c; }
  .badge-medium   { background: #ca8a04; }
  .badge-low      { background: #2563eb; }
  hr { border: none; border-top: 1px solid #e5e7eb; margin: 20px 0; }
  .section-title {
    font-size: 16px; font-weight: 700; margin: 24px 0 12px;
    padding-bottom: 6px; border-bottom: 2px solid #e5e7eb;
  }
  .section-title.critical { border-color: #dc2626; }
  .section-title.high     { border-color: #ea580c; }
  .section-title.medium   { border-color: #ca8a04; }
  .section-title.low      { border-color: #2563eb; }
  .card {
    background: #f7f8fa; border: 1px solid #e5e7eb;
    border-left: 4px solid #e5e7eb;
    border-radius: 4px; padding: 14px 16px; margin-bottom: 12px;
  }
  .card.critical { border-left-color: #dc2626; }
  .card.high     { border-left-color: #ea580c; }
  .card.medium   { border-left-color: #ca8a04; }
  .card.low      { border-left-color: #2563eb; }
  .card-title { font-size: 14px; font-weight: 700; margin-bottom: 8px; }
  .field { margin-bottom: 4px; }
  .field-label { font-weight: 600; color: #57606a; margin-right: 4px; }
  .no-findings {
    background: #f0fdf4; border: 1px solid #86efac; border-radius: 4px;
    padding: 16px 20px; color: #166534; font-weight: 600; font-size: 15px;
  }
  .footer {
    margin-top: 40px; padding-top: 12px; border-top: 1px solid #e5e7eb;
    text-align: center; color: #57606a; font-size: 12px;
  }
</style>
</head>
<body>
<div class="container">
  <h1>targetlint Report</h1>
  <div class="meta">
    <span><strong>Source:</strong> {{ source_path }}</span>
    <span><strong>Target:</strong> {{ target_path }}</span>
    <span><strong>Date:</strong> {{ generated_at }}</span>
  </div>
  <div class="badges">
    <div class="badge badge-critical">{{ counts.critical }} Critical</div>
    <div class="badge badge-high">{{ counts.high }} High</div>
    <div class="badge badge-medium">{{ counts.medium }} Medium</div>
    <div class="badge badge-low">{{ counts.low }} Low</div>
  </div>
  <hr>
  {% if not findings %}
  <div class="no-findings">&#10003; No violations found</div>
  {% else %}
    {% set severities = [('CRITICAL','critical'),('HIGH','high'),('MEDIUM','medium'),('LOW','low')] %}
    {% for sev_upper, sev_lower in severities %}
      {% set bucket = findings | selectattr('severity', 'equalto', sev_upper) | list %}
      {% if bucket %}
  <div class="section-title {{ sev_lower }}">{{ sev_upper[0] }}{{ sev_upper[1:] | lower }} Findings</div>
        {% for f in bucket %}
  <div class="card {{ sev_lower }}">
    <div class="card-title">[{{ f.severity }}] {{ f.rule }}</div>
    <div class="field"><span class="field-label">Assumption:</span>{{ f.assumption }}</div>
    <div class="field"><span class="field-label">Conflict:</span>{{ f.conflict }}</div>
    <div class="field"><span class="field-label">Location:</span>{{ f.location }}</div>
    <div class="field"><span class="field-label">Recommendation:</span>{{ f.recommendation }}</div>
  </div>
        {% endfor %}
      {% endif %}
    {% endfor %}
  {% endif %}
  <div class="footer">Made with IBM Bob</div>
</div>
</body>
</html>
